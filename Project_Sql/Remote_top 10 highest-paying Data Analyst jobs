with company_posting_counts as (
    select company_id, count(*) as posting_count
    from job_postings_fact
    where job_title_short = 'Data Analyst'
    group by company_id
),

highest_paying_Data_Analyst_jobs as (
    select job_title, company_id, job_location, salary_year_avg
    from job_postings_fact
    where job_title_short = 'Data Analyst' and
    salary_year_avg is not null and
    job_work_from_home = true and
    company_id in (
        select company_id 
        from company_posting_counts 
        where posting_count > 5
    )
    order by salary_year_avg desc
    limit 10
)

select job_title, name as company_name,
job_location, salary_year_avg
from highest_paying_Data_Analyst_jobs
inner join company_dim
on highest_paying_Data_Analyst_jobs.company_id
= company_dim.company_id;